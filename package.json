{
  "name": "civiclens-triage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "sh ./scripts/start-dev.sh",
    "dev:web": "next dev -H 0.0.0.0",
    "dev:ml": "sh ./scripts/start-ml.sh",
    "setup:ml": "sh ./scripts/setup-ml.sh",
    "build": "next build",
    "start": "sh ./scripts/start-prod.sh",
    "typecheck": "tsc --noEmit",
    "mobile:export": "next build && next export -o mobile/www || (mkdir -p mobile/www && cp -r out/* mobile/www/ 2>/dev/null || true)",
    "cap:sync": "bun run mobile:export && cap sync",
    "cap:android": "bun run cap:sync && cap open android",
    "cap:ios": "bun run cap:sync && cap open ios",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease bundleRelease",
    "ios:build": "cd ios/App && xcodebuild -workspace App.xcworkspace -scheme App -configuration Release -destination 'generic/platform=iOS' -archivePath build/App.xcarchive archive"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@neondatabase/serverless": "^0.10.4",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@uploadthing/react": "^6.7.44",
    "@xyflow/react": "^12.11.6",
    "animejs": "3.2.2",
    "drizzle-orm": "^0.36.4",
    "echarts": "5.6.0",
    "leaflet": "^1.9.4",
    "motion": "^13.4.1",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "three": "0.169.0",
    "tslib": "2.8.1",
    "uploadthing": "^6.7.44"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/animejs": "3.1.12",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  }
}
